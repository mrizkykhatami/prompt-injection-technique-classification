<mxfile host="app.diagrams.net"><diagram name="Gambar 1 - Alur Penelitian" id="alur"><mxGraphModel dx="800" dy="800" grid="1" gridSize="10" page="1" pageWidth="700" pageHeight="800"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="b1" value="&lt;b style=&quot;font-size:16px&quot;&gt;neuralchemy Prompt-injection-dataset (konfigurasi core)&lt;/b&gt;&lt;br&gt;pembagian resmi 4.391 / 941 / 942; masukan = kolom teks saja" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF3FA;strokeColor=#2B3A67;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=14;fontColor=#1F2A44;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="620" height="70" as="geometry"/></mxCell><mxCell id="b2" value="&lt;b style=&quot;font-size:16px&quot;&gt;Pemetaan kategori ke kelas&lt;/b&gt;&lt;br&gt;31 kategori → 6 kelas teknik K0–K5;&lt;br&gt;keluarkan control dan edge_case (59 / 16 / 14 baris)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#2B3A67;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=14;fontColor=#1F2A44;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="620" height="80" as="geometry"/></mxCell><mxCell id="b3" value="&lt;b style=&quot;font-size:16px&quot;&gt;Representasi teks (tanpa melibatkan data uji)&lt;/b&gt;&lt;br&gt;TF-IDF di-fit pada data latih, lalu latih+validasi (model akhir)&lt;br&gt;kata 1–2 gram | karakter 3–5 gram | all-MiniLM-L12-v2" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF3FA;strokeColor=#2B3A67;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=14;fontColor=#1F2A44;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="620" height="80" as="geometry"/></mxCell><mxCell id="b4" value="&lt;b style=&quot;font-size:16px&quot;&gt;Pengklasifikasi&lt;/b&gt;&lt;br&gt;Naive Bayes | SVM | Random Forest | MLP&lt;br&gt;(4 × 3 = 12 konfigurasi)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#2B3A67;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=14;fontColor=#1F2A44;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="620" height="80" as="geometry"/></mxCell><mxCell id="b5" value="&lt;b style=&quot;font-size:16px&quot;&gt;Pencarian hiperparameter pada data validasi&lt;/b&gt;&lt;br&gt;kriteria pemilihan: macro-F1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF3FA;strokeColor=#2B3A67;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=14;fontColor=#1F2A44;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="620" height="70" as="geometry"/></mxCell><mxCell id="b6" value="&lt;b style=&quot;font-size:16px&quot;&gt;Latih ulang pada data latih + validasi; satu kali evaluasi uji&lt;/b&gt;&lt;br&gt;RF dan MLP: 5 seed (42–46)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#2B3A67;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=14;fontColor=#1F2A44;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="620" height="70" as="geometry"/></mxCell><mxCell id="b7" value="&lt;b style=&quot;font-size:16px&quot;&gt;Evaluasi dan analisis&lt;/b&gt;&lt;br&gt;macro-F1, CI bootstrap, bootstrap berpasangan, McNemar + Holm;&lt;br&gt;per kelas, kategori, sumber; sumber disisihkan; NotInject; biner" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF3FA;strokeColor=#2B3A67;strokeWidth=1.5;fontFamily=Times New Roman;fontSize=14;fontColor=#1F2A44;" vertex="1" parent="1"><mxGeometry x="40" y="670" width="620" height="80" as="geometry"/></mxCell><mxCell id="e1" style="html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#2B3A67;strokeWidth=1.5;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#2B3A67;strokeWidth=1.5;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#2B3A67;strokeWidth=1.5;" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" style="html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#2B3A67;strokeWidth=1.5;" edge="1" parent="1" source="b4" target="b5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" style="html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#2B3A67;strokeWidth=1.5;" edge="1" parent="1" source="b5" target="b6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" style="html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#2B3A67;strokeWidth=1.5;" edge="1" parent="1" source="b6" target="b7"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>